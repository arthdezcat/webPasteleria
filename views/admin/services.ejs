<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DeliCakes Delia | Administrar Pastelerías</title>
  <link rel="stylesheet" href="/css/styles.css">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
  <link rel="icon" href="/img/administracion.png" type="image/png">
</head>
<body class="admin-page"> <!-- Clase específica para la página de admin -->
  <!-- Header with Navigation -->
  <header>
    <nav>
      <a href="/admin">
        <i class="fas fa-tachometer-alt"></i> Inicio
      </a> 
      <a href="/admin/services">
        <i class="fas fa-cake"></i> Productos
      </a>
      <a href="/admin/galeria">
        <i class="fas fa-images"></i> Galería
      </a>
      <a href="/admin/contact">
        <i class="fas fa-address-book"></i> Contacto
      </a>
      <a href="/logout">
        <i class="fas fa-sign-out-alt"></i> Cerrar Sesión
      </a>
    </nav>
  </header>

  <main>
    <div class="admin-container-servi">
      <!-- Sección para Registrar Pastelería -->
      <section class="add-service">
        <h1>Registrar Nueva Pastelería</h1>
        <form action="/admin/services/add" method="post" enctype="multipart/form-data" class="service-form-admin">
          <div class="form-group">
            <label for="title">Nombre de la Pastelería:</label>
            <input type="text" id="title" name="title" required>
          </div>

          <div class="form-group">
            <label for="description">Descripción:</label>
            <textarea id="description" name="description" required></textarea>
          </div>

          <div class="form-group">
            <label for="address">Dirección:</label>
            <input type="text" id="address" name="address" placeholder="Ej. Calle 123, Ciudad">
          </div>

          <div class="form-group">
            <label for="phone">Teléfono:</label>
            <input type="text" id="phone" name="phone" placeholder="Ej. +51 999 999 999">
          </div>

          <div class="form-group">
            <label for="schedule">Horario de Atención:</label>
            <input type="text" id="schedule" name="schedule" placeholder="Ej. Lun-Dom 9:00 - 20:00">
          </div>

          <div class="form-group">
            <label for="imageFile">Imagen:</label>
            <input type="file" id="imageFile" name="imageFile" accept="image/*">
            <label for="imageUrl">o URL de la Imagen:</label>
            <input type="url" id="imageUrl" name="imageUrl">
          </div>

          <button type="submit" class="submit-btn">Registrar Pastelería</button>
        </form>
      </section>

      <!-- Sección para Mostrar y Eliminar Pastelerías -->
      <section class="manage-services">
        <h2>Pastelerías Registradas</h2>
        <ul class="services-list-admin">
          <% services.forEach(service => { %>
            <li class="service-item-admin">
              <div class="service-details-admin">
              <strong><%= service.title %></strong>
              <p><%= service.description %></p>
              <% if (service.address) { %><p><strong>Dirección:</strong> <%= service.address %></p><% } %>
              <% if (service.phone) { %><p><strong>Teléfono:</strong> <%= service.phone %></p><% } %>
              <% if (service.schedule) { %><p><strong>Horario:</strong> <%= service.schedule %></p><% } %>
              </div>
              <form action="/admin/services/delete/<%= service._id %>" method="post" style="display: inline;">
                <button type="submit" class="delete-btn">Eliminar</button>
              </form>
              <form action="/admin/services/update/<%= service._id %>" method="post" enctype="multipart/form-data" class="service-form-admin" style="margin-top:8px;">
                <input type="text" name="title" value="<%= service.title %>" required>
                <input type="text" name="description" value="<%= service.description %>" required>
                <input type="text" name="address" value="<%= service.address || '' %>" placeholder="Dirección">
                <input type="text" name="phone" value="<%= service.phone || '' %>" placeholder="Teléfono">
                <input type="text" name="schedule" value="<%= service.schedule || '' %>" placeholder="Horario">
                <input type="file" name="imageFile" accept="image/*">
                <input type="url" name="imageUrl" placeholder="o URL de imagen">
                <button type="submit" class="submit-btn">Actualizar</button>
              </form>
            </li>
          <% }); %>
        </ul>
      </section>
    </div>
  </main>
</body>
</html>
