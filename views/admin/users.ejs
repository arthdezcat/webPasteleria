<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin - Usuarios</title>
  <link rel="stylesheet" href="/css/styles.css" />
  <link rel="stylesheet" href="/css/css.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
</head>
<body class="admin-page">
  <header>
    <nav>
      <a href="/admin"><i class="fas fa-tachometer-alt"></i> Inicio</a>
      <a href="/admin/services"><i class="fas fa-cake"></i> Pastelerías</a>
      <a href="/admin/galeria"><i class="fas fa-images"></i> Galería</a>
      <a href="/admin/contact"><i class="fas fa-address-book"></i> Contacto</a>
      <a href="/admin/homeinfo"><i class="fas fa-brush"></i> Inicio</a>
      <a href="/logout"><i class="fas fa-sign-out-alt"></i> Salir</a>
    </nav>
  </header>

  <section class="admin-container">
    <div class="admin-content">
      <h1 class="admin-title">Usuarios Administradores</h1>
      <p>Gestiona cuentas del panel. Usa "Registrar" para crear nuevos usuarios.</p>
    </div>

    <div class="admin-container-servi">
      <section class="add-service">
        <h2>Registrar nuevo</h2>
        <p>Ir al formulario de registro.</p>
        <a href="/register" class="admin-link">Registrar Usuario</a>
      </section>

      <section class="manage-services">
        <h2>Usuarios existentes</h2>
        <ul class="services-list-admin">
          <% users.forEach(u => { %>
            <li class="service-item-admin">
              <div class="service-details-admin">
                <strong><i class="fas fa-user"></i> <%= u.username %></strong>
              </div>
              <form action="/admin/users/delete/<%= u._id %>" method="POST" onsubmit="return confirm('¿Eliminar usuario?');">
                <button type="submit" class="delete-btn">Eliminar</button>
              </form>
            </li>
          <% }) %>
        </ul>
      </section>
    </div>
  </section>

  <footer>
    <p>&copy; <%= (homeInfo && homeInfo.brandName) || 'Pastelería' %></p>
  </footer>
</body>
</html>