<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DeliCakes Delia | Administrar Contactos</title>
  <link rel="stylesheet" href="/css/styles.css">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
  <link rel="icon" href="/img/administracion.png" type="image/png">
</head>
<body class="admin-page"> <!-- Clase específica para la página de admin -->
  <!-- Header with Navigation -->
  <header>
    <nav>
      <ul>
        <li><a href="/admin"><i class="fas fa-home"></i> Panel</a></li>
        <li><a href="/admin/homeinfo"><i class="fas fa-brush"></i> Inicio</a></li>
        <li><a href="/admin/postres"><i class="fas fa-ice-cream"></i> Postres</a></li>
        <li><a href="/admin/galeria"><i class="fas fa-images"></i> Galería</a></li>
        <li><a href="/admin/contact"><i class="fas fa-address-book"></i> Contactos</a></li>
        <li><a href="/logout"><i class="fas fa-sign-out-alt"></i> Salir</a></li>
        <li><button type="button" class="theme-toggle" aria-label="Cambiar tema">🌙</button></li>
      </ul>
    </nav>
  </header>
  <main>
    <div class="admin-container-contact">
      <!-- Sección para agregar contactos -->
      <section class="add-contact card">
        <h1>Agregar Contacto</h1>
        <% if (typeof errors !== 'undefined' && errors && errors.length) { %>
          <div class="card" style="margin:12px 0;padding:12px;background:#fff6f6;border-left:4px solid #e74c3c;color:#611a15;">
            <ul style="margin:0 0 0 18px;">
              <% errors.forEach(err => { %>
                <li><%= err.msg %></li>
              <% }) %>
            </ul>
          </div>
        <% } %>
        <% if (success_msg && success_msg.length) { %>
          <div class="card" style="margin:12px 0;padding:12px;background:#e6ffed;border-left:4px solid #2ecc71;color:#064e3b;">
            <% success_msg.forEach(m => { %>
              <div><%= m %></div>
            <% }) %>
          </div>
        <% } %>
        <% if (error_msg && error_msg.length) { %>
          <div class="card" style="margin:12px 0;padding:12px;background:#fff1f0;border-left:4px solid #e74c3c;color:#611a15;">
            <% error_msg.forEach(m => { %>
              <div><%= m %></div>
            <% }) %>
          </div>
        <% } %>
        <form action="/admin/contact/add" method="post" class="contact-form service-form-admin" enctype="multipart/form-data">
          <div class="form-grid">
            <div class="form-row">
              <label class="label-muted" for="name">Nombre</label>
              <% const errName = (errors || []).find(e => e.param === 'name'); %>
              <input type="text" id="name" name="name" required value="<%= old && old.name ? old.name : '' %>">
              <% if (errName) { %>
                <div class="field-error"><%= errName.msg %></div>
              <% } %>
            </div>

            <div class="form-row">
              <label class="label-muted" for="email">Email</label>
              <% const errEmail = (errors || []).find(e => e.param === 'email'); %>
              <input type="email" id="email" name="email" required value="<%= old && old.email ? old.email : '' %>">
              <% if (errEmail) { %>
                <div class="field-error"><%= errEmail.msg %></div>
              <% } %>
            </div>

            <div class="form-row">
              <label class="label-muted" for="telefono">Teléfono</label>
              <% const errTelefono = (errors || []).find(e => e.param === 'telefono'); %>
              <input type="text" id="telefono" name="telefono" required value="<%= old && old.telefono ? old.telefono : '' %>">
              <% if (errTelefono) { %>
                <div class="field-error"><%= errTelefono.msg %></div>
              <% } %>
            </div>

            <div class="form-row">
              <label class="label-muted" for="facebookUrl">Facebook URL</label>
              <% const errFacebook = (errors || []).find(e => e.param === 'facebookUrl'); %>
              <input type="url" id="facebookUrl" name="facebookUrl" placeholder="https://facebook.com/tu-pagina" value="<%= old && old.facebookUrl ? old.facebookUrl : '' %>">
              <% if (errFacebook) { %>
                <div class="field-error"><%= errFacebook.msg %></div>
              <% } %>
            </div>

            <div class="form-row">
              <label class="label-muted" for="messenger">Messenger (URL o usuario)</label>
              <% const errMessenger = (errors || []).find(e => e.param === 'messenger'); %>
              <input type="text" id="messenger" name="messenger" placeholder="https://m.me/tu.usuario o usuario" value="<%= old && old.messenger ? old.messenger : '' %>">
              <% if (errMessenger) { %>
                <div class="field-error"><%= errMessenger.msg %></div>
              <% } %>
            </div>

            <div class="form-row">
              <label class="label-muted" for="extraUrl">URL adicional</label>
              <% const errExtra = (errors || []).find(e => e.param === 'extraUrl'); %>
              <input type="url" id="extraUrl" name="extraUrl" placeholder="https://tusitio.com/info" value="<%= old && old.extraUrl ? old.extraUrl : '' %>">
              <% if (errExtra) { %>
                <div class="field-error"><%= errExtra.msg %></div>
              <% } %>
            </div>

            <div class="form-row">
              <label class="label-muted" for="footer">Texto de pie</label>
              <input type="text" id="footer" name="footer" placeholder="Texto que se muestra en la sección de contacto" value="<%= old && old.footer ? old.footer : '' %>">
            </div>

            <div class="form-row">
              <label class="label-muted" for="iconColor">Color de icono</label>
              <input type="color" id="iconColor" name="iconColor" value="<%= old && old.iconColor ? old.iconColor : '#ffffff' %>">
            </div>

            <div class="form-row full">
              <label class="label-muted" for="iconFile">Icono (imagen)</label>
              <input type="file" id="iconFile" name="iconFile" accept="image/*">
            </div>

            <div class="form-row full">
              <button type="submit" class="submit-btn">Añadir Contacto</button>
            </div>
          </div>
        </form>
      </section>

      <!-- Sección para administrar contactos -->
      <section class="manage-contact card">
        <h2>Contactos Actuales</h2>
        <ul class="contact-list-admin">
          <% contact.forEach(contact => { %>
            <li class="contact-item-admin">
              <div class="contact-details-admin">
                <strong><%= contact.name %></strong>
                <p>Email: <%= contact.email %></p>
                <p>Teléfono: <%= contact.telefono %></p>
                <% if (contact.facebookUrl) { %>
                  <p>Facebook: <a href="<%= contact.facebookUrl %>" target="_blank"><%= contact.facebookUrl %></a></p>
                <% } %>
                <% if (contact.extraUrl) { %>
                  <p>Info adicional: <a href="<%= contact.extraUrl %>" target="_blank"><%= contact.extraUrl %></a></p>
                <% } %>
                <% if (contact.footer) { %>
                  <p>Pie: <%= contact.footer %></p>
                <% } %>
                <% if (contact.iconUrl) { %>
                  <p>Icono:</p>
                  <img src="<%= contact.iconUrl %>" alt="icono" class="admin-icon" data-bg="<%= contact.iconColor || '' %>">
                <% } %>
              </div>
              <form action="/admin/contact/delete/<%= contact._id %>" method="post" style="margin:0;">
                <button type="submit" class="delete-btn">Eliminar</button>
              </form>
              <details style="margin-top:8px;">
                <summary style="cursor:pointer;color:#007bff;">Editar</summary>
                <form action="/admin/contact/update/<%= contact._id %>" method="post" enctype="multipart/form-data" class="service-form-admin" style="margin-top:10px;">
                  <div class="form-grid">
                    <div class="form-row">
                      <label class="label-muted">Nombre</label>
                      <input type="text" name="name" value="<%= contact.name %>" required>
                    </div>
                    <div class="form-row">
                      <label class="label-muted">Email</label>
                      <input type="email" name="email" value="<%= contact.email %>" required>
                    </div>
                    <div class="form-row">
                      <label class="label-muted">Teléfono</label>
                      <input type="text" name="telefono" value="<%= contact.telefono %>" required>
                    </div>
                    <div class="form-row">
                      <label class="label-muted">Facebook URL</label>
                      <input type="url" name="facebookUrl" value="<%= contact.facebookUrl || '' %>" placeholder="Facebook URL">
                    </div>
                    <div class="form-row">
                      <label class="label-muted">URL adicional</label>
                      <input type="url" name="extraUrl" value="<%= contact.extraUrl || '' %>" placeholder="URL adicional">
                    </div>
                    <div class="form-row">
                      <label class="label-muted">Texto pie</label>
                      <input type="text" name="footer" value="<%= contact.footer || '' %>" placeholder="Texto de pie">
                    </div>
                    <div class="form-row">
                      <label class="label-muted">Color Icono</label>
                      <input type="color" name="iconColor" value="<%= contact.iconColor || '#ffffff' %>">
                    </div>
                    <div class="form-row full">
                      <label class="label-muted">Icono (imagen)</label>
                      <input type="file" name="iconFile" accept="image/*">
                    </div>
                    <div class="form-row full">
                      <button type="submit" class="submit-btn">Actualizar</button>
                    </div>
                  </div>
                </form>
              </details>
            </li>
          <% }); %>
        </ul>
      </section>
    </div>
  </main>
  <script src="/js/theme-toggle.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function(){
      document.querySelectorAll('[data-bg]').forEach(function(el){
        var c = el.getAttribute('data-bg');
        if (c) el.style.background = c;
      });
    });
  </script>
</body>
</html>
