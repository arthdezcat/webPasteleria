<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DeliCakes Delia | Administrar Galería</title>
  <link rel="stylesheet" href="/css/styles.css">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
  <link rel="icon" href="/img/administracion.png" type="image/png">
</head>
<body class="admin-page">
  <header>
    <nav>
      <ul>
        <li><a href="/admin"><i class="fas fa-home"></i> Panel</a></li>
      <a href="/logout"><i class="fas fa-sign-out-alt"></i> Cerrar Sesión</a>
      <button type="button" class="theme-toggle" aria-label="Cambiar tema">🌙</button>
        <li><a href="/admin/postres"><i class="fas fa-ice-cream"></i> Postres</a></li>
        <li><a href="/admin/galeria"><i class="fas fa-images"></i> Galería</a></li>
        <li><a href="/admin/contact"><i class="fas fa-address-book"></i> Contactos</a></li>
        <li><a href="/logout"><i class="fas fa-sign-out-alt"></i> Salir</a></li>
      </ul>
    </nav>
  </header>

  <main>
    <div class="admin-container-galeris">
      <section class="add-gallery">
        <h1>Agregar a la Galería</h1>
        <form action="/admin/galeria/add" method="post" enctype="multipart/form-data" class="gallery-form">
          <div class="form-group">
            <label for="title">Título:</label>
            <input type="text" id="title" name="title" required>
          </div>
          <div class="form-group">
            <label for="description">Descripción:</label>
            <textarea id="description" name="description" required></textarea>
          </div>
          <div class="form-group">
            <label for="imageFile">Imagen:</label>
            <input type="file" id="imageFile" name="imageFile" accept="image/*">
            <label for="imageUrl">o URL de la Imagen:</label>
            <input type="url" id="imageUrl" name="imageUrl">
          </div>
          <button type="submit" class="submit-btn">Añadir a la Galería</button>
        </form>
      </section>

      <section class="manage-gallery">
        <h2>Galería Actual</h2>
        <ul class="gallery-list-admin">
          <% galeria.forEach(g => { %>
            <li class="gallery-item-admin">
              <div class="gallery-details-admin">
                <strong><%= g.title %></strong>
                <p><%= g.description %></p>
              </div>
              <form action="/admin/galeria/delete/<%= g._id %>" method="post">
                <button type="submit" class="delete-btn">Eliminar</button>
              </form>
              <form action="/admin/galeria/update/<%= g._id %>" method="post" enctype="multipart/form-data" class="gallery-form" style="margin-top:8px;">
                <input type="text" name="title" value="<%= g.title %>" required>
                <input type="text" name="description" value="<%= g.description %>" required>
                <input type="file" name="imageFile" accept="image/*">
                <input type="url" name="imageUrl" placeholder="o URL de imagen">
                <button type="submit" class="submit-btn">Actualizar</button>
              </form>
            </li>
          <% }); %>
        </ul>
      </section>
    </div>
  </main>
  <script src="/js/theme-toggle.js"></script>
</body>
</html>
