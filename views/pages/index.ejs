<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= (homeInfo && homeInfo.brandName) || 'DeliCakes Delia' %></title>
  <link rel="stylesheet" href="/css/styles.css">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
  <link rel="icon" href="<%= homeInfo && homeInfo.icon && homeInfo.icon.url ? homeInfo.icon.url : '/img/Logo.png' %>" type="image/png"> 
</head>
<body class="welcome-page" style="background-image:url('<%= homeInfo && homeInfo.homeBg && homeInfo.homeBg.url ? homeInfo.homeBg.url : '/img/home-f.jpg' %>')">
  <!-- Header with Navigation -->
  <header>
    <nav class="navbar">
      <div class="container">
        <ul class="nav">
          <li><a href="/"><i class="fas fa-home"></i> Inicio</a></li>
          <li><a href="/postres"><i class="fas fa-ice-cream"></i> Postres</a></li>
          <li><a href="/galeria"><i class="fas fa-images"></i> Pasteles</a></li>
          <li><a href="/contact"><i class="fas fa-address-book"></i> Contacto</a></li>
        </ul>
      </div>
    </nav>
  </header>

  <!-- Main Content Section -->
  <main>
    <div class="portada">
      <!-- Add a Hero Image or Logo -->
      <section class="portada-content-indice">
        <div class="content-header">
          <h2 class="brand-name">Bienvenido a <span><%= (homeInfo && homeInfo.brandName) || 'DeliCakes Delia' %></span></h2>
          <p class="intro-text"><%= (homeInfo && homeInfo.tagline) || 'Tradición y sabor en cada bocado' %></p>
          <p class="intro-text"><%= (homeInfo && homeInfo.descriptionHome) || '' %></p>
        </div>
        
        <!-- Products Section -->
        <div class="services-section">
          <h3 class="services-title">Nuestros Postres</h3>
          <div class="services-list">
            <div class="service-card">
              <i class="fas fa-cake fa-3x"></i>
              <h4>Pasteles Personalizados</h4>
              <p>Desde diseños clásicos hasta modernos, perfectos para cualquier ocasión especial.</p>
            </div>
            <div class="service-card">
              <i class="fas fa-birthday-cake fa-3x"></i>
              <h4>Postres para Fiestas</h4>
              <p>Disfruta de nuestros postres para todo tipo de celebraciones.</p>
            </div>
          </div>
        </div>
      
        <!-- About Section -->
        <div class="about-text">
          <h3 class="services-title">Sobre Nosotros</h3>
            <p>
            En <strong><%= (homeInfo && homeInfo.brandName) || 'DeliCakes Delia' %></strong>, nuestra pasión es hacer que cada momento sea especial. Ya sea para un cumpleaños, boda o simplemente para consentirte, nos encargamos de ofrecerte los postres más sabrosos y frescos. ¡Ven y disfruta de una experiencia única de sabor!
          </p>
        </div>
      </section>
    </div>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>