<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pastelerías | <%= (homeInfo && homeInfo.brandName) || 'Pastelería' %></title>
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/css.css">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
  <link rel="icon" href="<%= homeInfo && homeInfo.icon && homeInfo.icon.url ? homeInfo.icon.url : '/img/Logo.png' %>" type="image/png"> 
</head>
<body class="services-page" style="background-image:url('<%= homeInfo && homeInfo.servicesBg && homeInfo.servicesBg.url ? homeInfo.servicesBg.url : '/img/servicio.png' %>')">
  <!-- Header with Navigation -->
  <header>
    <nav class="navbar">
      <div class="container">
        <% if (homeInfo && homeInfo.logo && homeInfo.logo.url) { %>
          <img class="logo-img" src="<%= homeInfo.logo.url %>" alt="Logo" />
        <% } %>
        <ul class="nav">
          <li><a href="/"><i class="fas fa-home"></i> Inicio</a></li>
          <li><a href="/services"><i class="fas fa-cake"></i> Pastelerías</a></li>
          <li><a href="/galeria"><i class="fas fa-images"></i> Galería</a></li>
          <li><a href="/contact"><i class="fas fa-address-book"></i> Contacto</a></li>
        </ul>
      </div>
    </nav>
  </header>
 <!-- Main Content Section -->
 <main>
  <section class="portadaServi">
    <div class="portada-content">
      <h2><span class="brand-name-serv"><%= (homeInfo && homeInfo.brandName) || 'Pastelería' %> — Nuestras Pastelerías</span></h2>
      <p class="contact-descript">Explora y conoce nuestras pastelerías y puntos de atención.</p>
      
       <!-- Lista de Servicios Técnicos -->
       <div class="services-container">
        <% services.forEach(service => { %>
          <div class="service-item">
            <% if (service.image) { %>
              <img class="service-image" src="<%= service.image %>" alt="<%= service.title %>">
            <% } %>
            <div class="service-info">
              <h5 class="service-title"><%= service.title %></h5>
              <p class="service-description"><%= service.description %></p>
              <% if (service.address) { %><p class="service-address"><i class="fas fa-map-marker-alt"></i> <%= service.address %></p><% } %>
              <% if (service.phone) { %><p class="service-phone"><i class="fas fa-phone"></i> <%= service.phone %></p><% } %>
              <% if (service.schedule) { %><p class="service-schedule"><i class="fas fa-clock"></i> <%= service.schedule %></p><% } %>
            </div>
          </div>
        <% }); %>
      </div>
    </div>
  </section>
</main>

<footer>
  <p>&copy; 2025 DeliCakes Delia. Todos los derechos reservados.</p>
</footer>
</body>
</html>