<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Contacto | <%= (homeInfo && homeInfo.brandName) || 'DeliCakes Delia' %></title>
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/css.css">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
  <link rel="icon" href="<%= homeInfo && homeInfo.icon && homeInfo.icon.url ? homeInfo.icon.url : '/img/Logo.png' %>" type="image/png"> 
</head>
<body class="contact-page" style="background-image:url('<%= homeInfo && homeInfo.contactBg && homeInfo.contactBg.url ? homeInfo.contactBg.url : '/img/Contact.jpg' %>')"> <!-- Clase específica para la página de contacto -->
  <!-- Header with Navigation -->
  <header>
    <nav class="navbar">
      <div class="container">
        <ul class="nav">
          <li><a href="/"><i class="fas fa-home"></i> Inicio</a></li>
          <li><a href="/services"><i class="fas fa-cake"></i> Productos</a></li>
          <li><a href="/galeria"><i class="fas fa-images"></i> Galería</a></li>
          <li><a href="/contact"><i class="fas fa-address-book"></i> Contacto</a></li>
        </ul>
      </div>
    </nav>
  </header>

  <!-- Main Content Section -->
  <main>
    <div class="portada">
      <section class="portada-content">
        <h2><span class="brand-name-serv"><%= (homeInfo && homeInfo.brandName) || 'DeliCakes Delia' %> — Contacto</span></h2>
        <p class="contact-descript">
          En <strong><%= (homeInfo && homeInfo.brandName) || 'DeliCakes Delia' %></strong>, tu satisfacción es nuestra prioridad. Estamos aquí para responder a tus preguntas, 
          escuchar tus sugerencias y ayudarte a disfrutar de nuestros deliciosos productos. Contáctanos para hacer un pedido, obtener más 
          información sobre nuestros postres o cualquier otra consulta. ¡Será un placer ayudarte!
        </p>
        <div class="contacts-container">
          <% contact.forEach(item => { %>
            <div class="contact-item" style="display:flex;gap:12px;align-items:center;">
              <% if (item.iconUrl) { %>
                <img src="<%= item.iconUrl %>" alt="icono" style="width:56px;height:56px;border-radius:12px;object-fit:cover;<%= item.iconColor ? 'background:'+item.iconColor+';' : '' %>">
              <% } %>
              <div>
                <h3 class="contact-name">Nombre: <%= item.name %></h3>
                <p class="contact-email">
                  <strong>Correo:</strong>
                  <% if (item.emailUrl) { %>
                    <a href="<%= item.emailUrl %>" style="color:inherit;text-decoration:underline;"><%= item.email %></a>
                  <% } else { %>
                    <%= item.email %>
                  <% } %>
                </p>
                <p class="contact-phone">
                  <strong>WhatsApp/Teléfono:</strong>
                  <% if (item.whatsappUrl) { %>
                    <a href="<%= item.whatsappUrl %>" target="_blank" style="color:inherit;text-decoration:underline;"><%= item.telefono %></a>
                  <% } else { %>
                    <%= item.telefono %>
                  <% } %>
                </p>
                <% if (item.facebookUrl) { %>
                  <p><strong>Facebook:</strong> <a href="<%= item.facebookUrl %>" target="_blank"><%= item.facebookUrl %></a></p>
                <% } %>
                <% if (item.extraUrl) { %>
                  <p><strong>Información adicional:</strong> <a href="<%= item.extraUrl %>" target="_blank"><%= item.extraUrl %></a></p>
                <% } %>
                <% if (item.footer) { %>
                  <p style="opacity:0.8"><%= item.footer %></p>
                <% } %>
              </div>
            </div>
          <% }); %>
        </div>
      </section>
    </div>
  </main>

  <footer>
    <p>&copy; <%= (homeInfo && homeInfo.brandName) || 'DeliCakes Delia' %></p>
  </footer>
</body>
</html>