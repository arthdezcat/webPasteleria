<body class="contact-page" style="background-image:url('<%= homeInfo && homeInfo.contactBg && homeInfo.contactBg.url ? homeInfo.contactBg.url : '/img/Contact.jpg' %>')"> <!-- Clase específica para la página de contacto -->
  <!-- Header with Navigation -->
  <header>
    <nav class="navbar">
      <div class="container">
        <ul class="nav">
          <li><a href="/"><i class="fas fa-home"></i> Inicio</a></li>
          <li><a href="/postres"><i class="fas fa-ice-cream"></i> Postres</a></li>
          <li><a href="/galeria"><i class="fas fa-images"></i> Pasteles</a></li>
          <li><a href="/contact"><i class="fas fa-address-book"></i> Contacto</a></li>
        </ul>
      </div>
    </nav>
  </header>

  <!-- Main Content Section -->
  <main>
    <div class="portada">
      <section class="portada-content">
        <h2><span class="brand-name-serv"><%= (homeInfo && homeInfo.brandName) || 'DeliCakes Delia' %> — Contacto</span></h2>
        <p class="contact-descript">
          En <strong><%= (homeInfo && homeInfo.brandName) || 'DeliCakes Delia' %></strong>, tu satisfacción es nuestra prioridad. Estamos aquí para responder a tus preguntas, 
          escuchar tus sugerencias y ayudarte a disfrutar de nuestros deliciosos productos. Contáctanos para hacer un pedido, obtener más 
          información sobre nuestros postres o cualquier otra consulta. ¡Será un placer ayudarte!
        </p>
        <div class="contact-links">
          <% if ((contact[0] && contact[0].emailUrl)) { %>
            <a href="<%= contact[0].emailUrl %>" class="social-btn gmail" title="Email">
              <i class="fas fa-envelope"></i> <span style="margin-left:6px;">Correo</span>
            </a>
          <% } %>
          <% if ((contact[0] && contact[0].facebookUrl)) { %>
            <a href="<%= contact[0].facebookUrl %>" target="_blank" class="social-btn facebook" title="Facebook">
              <i class="fab fa-facebook-f"></i> <span style="margin-left:6px;">Facebook</span>
            </a>
          <% } %>
          <% if ((contact[0] && contact[0].whatsappUrl)) { %>
            <a href="<%= contact[0].whatsappUrl %>" target="_blank" class="social-btn whatsapp" title="WhatsApp">
              <i class="fab fa-whatsapp"></i> <span style="margin-left:6px;">WhatsApp</span>
            </a>
          <% } %>
        </div>

        <div class="contacts-container">
