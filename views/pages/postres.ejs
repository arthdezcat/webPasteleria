<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Postres | <%= (homeInfo && homeInfo.brandName) || 'DeliCakes Delia' %></title>
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/css.css">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
  <link rel="icon" href="<%= homeInfo && homeInfo.icon && homeInfo.icon.url ? homeInfo.icon.url : '/img/Logo.png' %>" type="image/png"> 
</head>
<body class="services-page" style="background-image:url('<%= homeInfo && homeInfo.servicesBg && homeInfo.servicesBg.url ? homeInfo.servicesBg.url : '/img/servicio.png' %>')">
  <!-- Header with Navigation -->
  <header>
    <nav class="navbar">
      <div class="container">
        <ul class="nav">
          <li><a href="/"><i class="fas fa-home"></i> Inicio</a></li>
          <li><a href="/postres"><i class="fas fa-ice-cream"></i> Postres</a></li>
          <li><a href="/galeria"><i class="fas fa-images"></i> Galería</a></li>
          <li><a href="/contact"><i class="fas fa-address-book"></i> Contacto</a></li>
        </ul>
      </div>
    </nav>
  </header>
 <!-- Main Content Section -->
 <main>
  <section class="portadaServi">
    <div class="portada-content">
      <h2><span class="brand-name-serv"><%= (homeInfo && homeInfo.brandName) || 'DeliCakes Delia' %> — Nuestros Postres</span></h2>
      <p class="contact-descript">Explora y conoce nuestros postres y delicias.</p>
      <div class="services-container">
        <% postres.forEach(p => { %>
          <div class="service-item">
            <% if (p.image) { %>
              <img class="service-image" src="<%= p.image %>" alt="<%= p.title %>">
            <% } %>
            <div class="service-info">
              <h5 class="service-title"><%= p.title %></h5>
              <p class="service-description"><%= p.description %></p>
              <% if (p.price) { %><p class="service-schedule"><i class="fas fa-tag"></i> Precio: <%= p.price %></p><% } %>
              <% const c = (typeof contact !== 'undefined' && contact && contact.length ? contact[0] : null); %>
              <% const brand = (homeInfo && homeInfo.brandName) || 'DeliCakes Delia'; %>
              <% const msg = `Hola ${brand}, me interesa el postre '${p.title}'. ¿Podrían darme más detalles?`; %>
              <div class="send-msg-buttons">
                <% if (c && c.whatsappUrl) { %>
                  <a href="<%= c.whatsappUrl %>?text=<%= encodeURIComponent(msg) %>" target="_blank" class="social-btn whatsapp" title="WhatsApp">
                    <i class="fab fa-whatsapp"></i> Consultar
                  </a>
                <% } %>
                <% if (c && c.emailUrl) { %>
                  <a href="<%= c.emailUrl %>?subject=<%= encodeURIComponent('Consulta sobre ' + p.title) %>&body=<%= encodeURIComponent(msg) %>" class="social-btn gmail" title="Email">
                    <i class="fas fa-envelope"></i> Email
                  </a>
                <% } %>
                <% if (c && c.facebookUrl) { %>
                  <a href="<%= c.facebookUrl %>" target="_blank" class="social-btn facebook" title="Facebook">
                    <i class="fab fa-facebook-f"></i> Facebook
                  </a>
                <% } %>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    </div>
  </section>
</main>

<footer>
  <% const cf = (typeof contact !== 'undefined' && contact && contact.length ? contact[0] : null); %>
  <div class="footer-social">
    <div class="social-links">
      <% if (cf && cf.emailUrl) { %>
        <a href="<%= cf.emailUrl %>" class="social-btn gmail" title="Email">
          <i class="fas fa-envelope"></i>
        </a>
      <% } %>
      <% if (cf && cf.facebookUrl) { %>
        <a href="<%= cf.facebookUrl %>" target="_blank" class="social-btn facebook" title="Facebook">
          <i class="fab fa-facebook-f"></i>
        </a>
      <% } %>
      <% if (cf && cf.whatsappUrl) { %>
        <a href="<%= cf.whatsappUrl %>" target="_blank" class="social-btn whatsapp" title="WhatsApp">
          <i class="fab fa-whatsapp"></i>
        </a>
      <% } %>
    </div>
    <p>&copy; 2025 DeliCakes Delia. Todos los derechos reservados.</p>
  </div>
</footer>
</body>
</html>